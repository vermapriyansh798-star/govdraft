# GovDraft Ecosystem – Environment Variables
# Copy this file to .env and fill in the values

# Groq API key for LLM-powered RFP generation
# Get yours at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Database URL (default: SQLite file in project root)
# For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/govdraft
# DATABASE_URL=sqlite+aiosqlite:///./govdraft.db
